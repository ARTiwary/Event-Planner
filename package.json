{
  "name": "gather-ai-event-planner",
  "version": "2.0.0",
  "description": "GenAI planning assistant for weddings, birthdays and community events. Groq + OpenAI gpt-oss. Zero runtime dependencies.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "coverage": "node --test --experimental-test-coverage \"tests/*.test.js\"",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  }
}
